#include<iostream>
#include<string>
using namespace std;
int main()
{
int numberofgames,size,Anton=0,Danik=0;;
cin>>numberofgames;
string s;
cin>>s;
size=s.size();
for(int i=0;i<size;i++)
{
    if(s.at(i)=='A')
    {
        Anton++;
    }
    else
    {
        Danik++;
    }
}


if (Danik>Anton)
{
    cout <<"Danik"<<endl;
}
if(Danik==Anton)
{
    cout <<"Friendship"<<endl;
}
if (Anton>Danik)
{
cout <<"Anton"<<endl;
}

}
